# Twilight Struggle Playfield: what stays OUT of the public repository.
# Committed on purpose (owner decision 2026-11-23; CI only installs, checks and builds):
#   public/engine/  the WASM rules engine (scripts/build-engine.sh)
#   public/cards/   the card images incl. the errata overlays (scripts/build-cards.mjs)
#   public/models/  the pinned ONNX model (scripts/fetch-model.sh)
# vendor/DeepStruggle is a git submodule: its contents are DeepStruggle's own repository.

# Dependencies, build output, caches
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
.vite-*/
.cache/
coverage/
__pycache__/
*.pyc

# GMT copyrighted reference material: never publish
game_resources/TS_Rules_Deluxe.pdf
game_resources/TS_map.jpg
# The original card galleries (inputs of scripts/build-cards.mjs): only the web-sized
# public/cards/ derived from them are published. game_resources/card_text.json stays in.
game_resources/English_card_gallery/
game_resources/Chinese_card_gallery/

# Screenshot sets: regenerated by the */demo/shoot.mjs scripts and the QA tools.
# Keep only the approved design references (docs/design/shots/final-*.png).
docs/design/shots/*
!docs/design/shots/final-*.png
docs/qa/shots/

# Playwright / browser-run outputs
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.trace.zip

# Logs, secrets, editor and OS files
*.log
npm-debug.log*
.env*
.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
